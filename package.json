{
  "name": "niupic",
  "version": "2.1.0",
  "private": true,
  "description": "牛图 NiuPic - 飞牛 fnOS 上的轻量、快速、稳定的图像素材检索浏览应用（基于 FlyPic 二次开发）",
  "keywords": [
    "fnos",
    "飞牛",
    "图片管理",
    "素材库",
    "相册",
    "image",
    "gallery",
    "niupic"
  ],
  "author": "LiuFudi <https://github.com/LiuFudi>",
  "contributors": [
    "ZangXincz <https://github.com/ZangXincz> (FlyPic 原作者)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiuFudi/NiuPic.git"
  },
  "homepage": "https://github.com/LiuFudi/NiuPic",
  "bugs": {
    "url": "https://github.com/LiuFudi/NiuPic/issues"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "dev": "npm run dev:backend",
    "build:fpk": "node scripts/build-fpk.js",
    "test": "npm --workspace frontend run test",
    "test:backend": "npm --workspace backend run test"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
