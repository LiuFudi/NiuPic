# 依赖目录
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 构建输出
dist/
build/
out/
*.log

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 操作系统文件
Thumbs.db
desktop.ini

# 临时文件
*.tmp
*.temp
.cache/
.temp/

# 测试覆盖率
coverage/
*.coverage
.nyc_output/

# 知识库文件夹 - 不同步到 GitHub
Knowledge base/

# 构建输出
dist/
niupic.zip
nipic.zip

# 飞牛应用包里的后端目录是构建产物（scripts/build*.js 会自动生成）
# 不要把 backend/ 的副本提交进来 —— 两份代码并存很容易改错地方
niupic/app/server/

# 原生模块二进制（按平台生成，不进仓库）
*.node
!niupic/app/ui/**

# 测试数据
test-library/
*.db
*.db-shm
*.db-wal

# 根目录放的 logo 原图（相同内容已收录为 design/logo.png）
/牛图.png

# 打包用的压缩包（发布时走 GitHub Release，不进仓库）
/*.zip
*.fpk

# 打包脚本生成的文件（真源是根目录的 LICENSE 与 scripts/，不要提交副本）
/niupic/app/ui/LICENSE.txt
/niupic/app/server/

# 交付存档（备份区里每个版本一个目录，见 交付存档.md）。
# 这些规则只在"备份区的那个 clone"里有意义 —— 存档跟着备份区走，不进源码仓库。
/[0-9]*.[0-9]*/

# 交付存档索引（描述备份区目录结构，不属于源码项目本身）
/交付存档.md
