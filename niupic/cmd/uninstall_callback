# 卸载回调
#
# ⚠️ 这里的默认行为必须是「什么都不删」。
#
# 原因：飞牛在**通过应用市场手动安装来更新版本**时，会先把旧版本按卸载流程走一遍
# （见 /var/log/apps/niupic.log：Stopping → 卸载清理 → Starting），再装新版本。
# 如果这里无条件删配置，每次更新都等于重装：素材库列表、主题色、访问密码、
# JWT 密钥全丢，用户得从头配一遍 —— 2.1.1 及之前就是这么干的，已经坑过两次。
#
# 所以只有用户在「卸载向导」里明确选了「全部删除」才动数据。
# 官方文档也写明了「卸载逻辑不得擅自删除用户数据」。
#
# 向导值通过同名环境变量传入（见 wizard/uninstall 里的 wizard_data_action）。

LOG="${TRIM_TEMP_LOGFILE:-/dev/null}"

log() {
    echo "$1"
    if [ "$LOG" != "/dev/null" ]; then
        echo "$1" >> "$LOG" 2>/dev/null
    fi
}

ACTION="${wizard_data_action:-keep}"

log "🧹 NiuPic 卸载清理（数据策略: ${ACTION}）"

if [ "$ACTION" != "delete" ]; then
    log "✅ 已保留配置和数据（素材库列表、主题色、访问密码都还在）"
    log "💡 重新安装后直接就能用，不需要重新配置"
    exit 0
fi

# ---- 以下只在用户明确选择「全部删除」时执行 ----

# 安全护栏：宁可少删，也不能因为变量为空/异常删错目录。
# 只认「…/@appdata/<应用名>」这种形态，空值、/、$HOME 之类一律拒绝。
APP_NAME="${TRIM_APPNAME:-niupic}"
case "${TRIM_PKGVAR}" in
    */@appdata/"${APP_NAME}") ;;
    *)
        log "⚠️  数据目录看起来不正常（'${TRIM_PKGVAR}'），为安全起见不做删除"
        exit 0
        ;;
esac

if [ -d "${TRIM_PKGVAR}" ]; then
    log "🗑️  删除应用数据目录: ${TRIM_PKGVAR}"
    rm -rf "${TRIM_PKGVAR}" 2>/dev/null || log "⚠️  删除失败（可能没有权限）"
else
    log "📝 数据目录不存在，跳过"
fi

# 配置的正式位置是 etc/（TRIM_PKGETC，2.5.5 起）—— 用户选的是「全部删除」，
# 只删 var/ 会留下素材库列表和访问口令，那不是他要的结果。
# 护栏同样是"只认自己那一个目录"，空值 / 被改坏的值一律不删。
case "${TRIM_PKGETC:-}" in
    */@appconf/"${APP_NAME}")
        if [ -d "${TRIM_PKGETC}" ]; then
            log "🗑️  删除应用配置目录: ${TRIM_PKGETC}"
            rm -rf "${TRIM_PKGETC}" 2>/dev/null || log "⚠️  删除失败（可能没有权限）"
        fi
        ;;
    *)
        if [ -n "${TRIM_PKGETC:-}" ]; then
            log "⚠️  配置目录看起来不正常（'${TRIM_PKGETC}'），为安全起见不做删除"
        fi
        ;;
esac

log "✨ 卸载清理完成"
log "💡 素材库里的 .niupic 数据和照片都没有动，需要的话请自行在文件管理器中处理"

exit 0
