LOG="${TRIM_TEMP_LOGFILE:-/tmp/niupic_install.log}"
exec >> "$LOG" 2>&1
set -x

echo "=== NiuPic 安装初始化开始 ==="
echo "时间: $(date)"
echo "应用名称: ${TRIM_APPNAME}"
echo "应用版本: ${TRIM_APPVER}"
echo "用户名: ${TRIM_USERNAME}"
echo "用户组: ${TRIM_GROUPNAME}"
echo "数据共享路径: ${TRIM_DATA_SHARE_PATHS}"
echo "应用目录: ${TRIM_APPDEST}"
echo "数据目录: ${TRIM_PKGVAR}"
echo "临时目录: ${TRIM_PKGTMP}"

# 获取用户设置的端口（从安装向导）
APP_PORT="${wizard_app_port:-15002}"
echo "用户设置端口: ${APP_PORT}"

# 更新 UI 配置中的端口
UI_CONFIG="${TRIM_APPDEST}/ui/config"
if [ -f "$UI_CONFIG" ]; then
    sed -i "s/\"port\": \"[0-9]*\"/\"port\": \"${APP_PORT}\"/" "$UI_CONFIG"
    echo "已更新 UI 配置端口为: ${APP_PORT}"
fi

# 保存端口配置供 main 脚本使用
echo "APP_PORT=${APP_PORT}" > "${TRIM_PKGVAR}/port.conf"

# ---- 配置恢复 ----
# 更新版本时，飞牛会先跑一遍旧版本的卸载流程。老版本的卸载脚本会删 config.json，
# 那份配置里装着素材库列表、访问密码、主题色等，删了就得从头配一遍。
# 新版本的卸载脚本已经改成默认保留，这里再补一道保险：
# 只要 config.json 不在了、而备份还在，就自动恢复。
CONFIG_FILE="${TRIM_PKGVAR}/config.json"
CONFIG_BAK="${TRIM_PKGVAR}/config.json.bak"
if [ ! -f "$CONFIG_FILE" ] && [ -f "$CONFIG_BAK" ]; then
    if cp "$CONFIG_BAK" "$CONFIG_FILE" 2>/dev/null; then
        echo "已从备份恢复配置: ${CONFIG_BAK} -> ${CONFIG_FILE}"
    else
        echo "⚠️  配置恢复失败（备份文件不可读或没有写权限）"
    fi
elif [ -f "$CONFIG_FILE" ]; then
    echo "配置已存在，保持不动: ${CONFIG_FILE}"
fi

echo "=== 安装初始化完成 ==="

exit 0
